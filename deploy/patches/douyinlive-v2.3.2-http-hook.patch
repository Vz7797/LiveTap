 	// 空值使用 DefaultProtocolMode。取值非法时构造失败并返回 ErrProtocolModeInvalid。
 	// ProtocolMode selects the protocol profile: "web" is the stable default, while "pc"
@@ -82,7 +95,15 @@ func NewDouyinLiveWithOptions(liveID string, logger Logger, options Options) (*D
 	default:
 		return nil, errors.New("sign provider must be local or tikhub")
 	}
-	return newDouyinLiveWithProxy(liveID, logger, options.Cookie, signer, options.ProxyURL, options.ProtocolMode)
+	dl, err := newDouyinLiveWithProxy(liveID, logger, options.Cookie, signer, options.ProxyURL, options.ProtocolMode)
+	if err != nil {
+		return nil, err
+	}
+	dl.beforeRequest = options.BeforeRequest
+	dl.afterResponse = options.AfterResponse
+	dl.guestTTWID = options.GuestTTWID
+	dl.installRequestHook()
+	return dl, nil
 }
 
